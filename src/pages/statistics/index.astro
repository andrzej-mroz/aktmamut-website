---
import MobileHeader from '../../components/mobile/MobileHeader.astro';
import StatisticsTable from '../../components/statistics/StatisticsTable.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="GOT Statistics" description="Cumulative GOT points divided into ten-day periods for each year." lang="en" showFooter={false}>
  <div class="statistics-page">
    <MobileHeader />

    <main class="statistics-main">
      <section class="statistics-intro">
        <h1>GOT Statistics</h1>

        <p>Cumulative GOT points divided into ten-day periods for each year.</p>
      </section>

      <StatisticsTable />
    </main>
  </div>
</BaseLayout>

<style>
  .statistics-page {
    min-height: calc(100dvh - var(--header-height));
    background: var(--color-background);
  }

  .statistics-main {
    width: min(100%, 1480px);
    margin-inline: auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .statistics-intro {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-radius: 0.6rem;
    background: linear-gradient(135deg, var(--color-surface), #eef5f1);
    box-shadow: var(--shadow);
  }

  .statistics-intro h1 {
    flex: 0 0 auto;
    margin: 0 0 0 0.3rem;
    font-family: var(--font-family-heading);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1;
  }

  .statistics-intro p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.1;
  }

  @media (max-width: 48rem) {
    .statistics-page {
      min-height: 100dvh;
    }

    .statistics-main {
      padding: 0.75rem 0.7rem 1.5rem;
    }

    .statistics-intro {
      display: flex;
      flex-wrap: nowrap;
      align-items: baseline;
      gap: 0.45rem;
      margin-bottom: 0.4rem;
      padding: 0.35rem 0.55rem;
      border-radius: 0.5rem;
    }

    .statistics-intro h1 {
      flex: 0 0 auto;
      margin-left: 0.2rem;
      font-size: 1.05rem;
    }

    .statistics-intro p {
      min-width: 0;
      margin: 0;
      font-size: 0.55rem;
      line-height: 1.1;
      white-space: nowrap;
    }
  }
</style>
