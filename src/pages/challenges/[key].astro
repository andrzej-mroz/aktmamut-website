---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

import MobileHeader from '../../components/mobile/MobileHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

import ChallengeMap from '../../components/challenges/ChallengeMap.astro';

interface ChallengeMeta {
  key: string;
  name: string;
  icon: string;
}

interface Props {
  challenge: ChallengeMeta;
}

export async function getStaticPaths() {
  const indexPath = join(process.cwd(), 'public', 'challenges', 'data', 'challenges-index.json');

  const challenges = JSON.parse(await readFile(indexPath, 'utf8')) as ChallengeMeta[];

  return challenges.map((challenge) => ({
    params: {
      key: challenge.key,
    },
    props: {
      challenge,
    },
  }));
}

const { challenge } = Astro.props;
---

<BaseLayout title={challenge.name} description={`Interactive map of the ${challenge.name} challenge.`} lang="en" showFooter={false}>
  <div class="challenge-page">
    <MobileHeader />

    <section class="challenge-map-shell" aria-label={`${challenge.name} map`}>
      <ChallengeMap challengeKey={challenge.key} challengeName={challenge.name} />
    </section>
  </div>
</BaseLayout>

<style>
  .challenge-page {
    display: flex;
    min-height: calc(100dvh - var(--header-height));
    flex-direction: column;
  }

  .challenge-map-shell {
    position: relative;
    z-index: 0;
    min-height: 0;
    flex: 1;
    isolation: isolate;
  }

  @media (max-width: 48rem) {
    .challenge-page {
      min-height: 100dvh;
    }
  }
</style>
