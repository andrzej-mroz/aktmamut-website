---
import AboutProjectSection from "../components/home/AboutProjectSection.astro";
import FeaturedDirectionsSection from "../components/home/FeaturedDirectionsSection.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProjectModulesSection from "../components/home/ProjectModulesSection.astro";
import ProjectStatementSection from "../components/home/ProjectStatementSection.astro";
import {
  homepageFeatures,
  homepageHeroActions,
  homepageHeroVideo,
  homepageMetrics,
  homepageModules,
} from "../data/homepage";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AKT Mamut"
  description="AKT Mamut — expeditions, mountain challenges and geographic exploration."
  lang="en"
>
  <HomeHero actions={homepageHeroActions} video={homepageHeroVideo} />
  <ProjectStatementSection />
  <ProjectModulesSection modules={homepageModules} />
  <FeaturedDirectionsSection features={homepageFeatures} />
  <AboutProjectSection metrics={homepageMetrics} />
</BaseLayout>
