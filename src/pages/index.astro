---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AKT Mamut"
  description="AKT Mamut — expeditions, mountain challenges and geographic exploration."
>
  <section class="page-section" aria-labelledby="foundation-title">
    <div class="container page-content">
      <div class="introduction">
        <p class="eyebrow">AKT Mamut</p>
        <h1 id="foundation-title">Astro migration foundation</h1>
        <p class="lead">The shared layout and design foundation are now active.</p>
        <p>
          The legacy website remains unchanged while the presentation layer is migrated
          incrementally.
        </p>
      </div>

      <section class="status-panel" aria-labelledby="migration-status-title">
        <h2 id="migration-status-title">Current migration status</h2>
        <dl class="status-list">
          <div>
            <dt>Astro foundation:</dt>
            <dd>complete</dd>
          </div>
          <div>
            <dt>Shared layout:</dt>
            <dd>complete</dd>
          </div>
          <div>
            <dt>Legacy homepage migration:</dt>
            <dd>not started</dd>
          </div>
          <div>
            <dt>Leaflet maps migration:</dt>
            <dd>not started</dd>
          </div>
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .page-content {
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
  }

  .introduction {
    max-width: 48rem;
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.25rem, 7vw, 4.75rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin-top: var(--space-5);
    color: var(--color-text);
    font-size: clamp(1.125rem, 3vw, 1.375rem);
  }

  .introduction p:last-child {
    max-width: 42rem;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .status-panel {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .status-panel h2 {
    font-size: 1rem;
  }

  .status-list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .status-list div {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .status-list dt {
    color: var(--color-text-muted);
  }

  .status-list dd {
    color: var(--color-text);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .status-list div {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .page-content {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      align-items: start;
    }
  }
</style>

