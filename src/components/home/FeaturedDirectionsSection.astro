---
import type { HomepageFeature } from "../../data/homepage";

interface Props {
  features: readonly HomepageFeature[];
}

const { features } = Astro.props;
---

<section
  class="featured page-section"
  aria-labelledby="featured-directions-title"
>
  <div class="container">
    <header class="section-header">
      <h2 id="featured-directions-title">Featured directions</h2>
      <p>
        A visual preview of the project’s strongest directions, ready to be
        replaced later with real expeditions and photos.
      </p>
    </header>

    <ul class="featured-grid" role="list">
      {
        features.map((feature) => (
          <li>
            <a class="featured-card" href={feature.destination.href}>
              <span class="featured-field" aria-hidden="true">
                <span />
                <span />
                <span />
              </span>
              <span class="featured-body">
                <span class="eyebrow">{feature.eyebrow}</span>
                <h3>{feature.title}</h3>
                <span class="description">{feature.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .featured {
    padding-top: 0;
    background: var(--color-background);
  }

  .section-header {
    max-width: 45rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
  }

  .section-header p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-grid > li {
    min-width: 0;
  }

  .featured-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    color: var(--color-text);
    text-decoration: none;
  }

  .featured-card:hover {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 48%,
      var(--color-border)
    );
    color: var(--color-text);
  }

  .featured-field {
    display: grid;
    min-height: 7.5rem;
    align-content: center;
    gap: var(--space-3);
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .featured-field span {
    display: block;
    height: 1px;
    background: color-mix(
      in srgb,
      var(--color-accent) 28%,
      var(--color-border)
    );
  }

  .featured-field span:nth-child(2) {
    width: 72%;
  }

  .featured-field span:nth-child(3) {
    width: 44%;
  }

  .featured-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.375rem, 4vw, 1.75rem);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .description {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (min-width: 40rem) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 70rem) {
    .featured-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
