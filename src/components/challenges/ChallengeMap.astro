---
interface Props {
  challengeKey: string;
  challengeName: string;
}

const { challengeKey, challengeName } = Astro.props;
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />

<div class="challenge-map-frame" data-challenge-map-frame data-challenge-key={challengeKey} data-challenge-name={challengeName}>
  <div class="challenge-topbar">
    <strong>{challengeName}</strong>
    <span data-challenge-progress>Loading…</span>

    <span class="challenge-legend">
      <span><i class="done"></i> Done</span>
      <span><i class="todo"></i> Todo</span>
    </span>
  </div>

  <div class="challenge-map" data-challenge-map aria-label={`Interactive map of ${challengeName}`}></div>
</div>

<script is:inline>
  const loadLeaflet = () =>
    new Promise((resolve, reject) => {
      if (window.L) {
        resolve(window.L);
        return;
      }

      const existingScript = document.querySelector('script[data-leaflet-script]');

      if (existingScript) {
        existingScript.addEventListener('load', () => resolve(window.L), {
          once: true,
        });

        return;
      }

      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
      script.dataset.leafletScript = 'true';

      script.addEventListener('load', () => resolve(window.L), {
        once: true,
      });

      script.addEventListener('error', () => reject(new Error('Leaflet could not be loaded.')), { once: true });

      document.head.appendChild(script);
    });

  const escapeHtml = (value) =>
    String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const formatChallengeDate = (value) => {
    if (value === null || value === undefined || value === '') {
      return '—';
    }

    const numericValue = Number(value);

    if (Number.isFinite(numericValue)) {
      const excelEpoch = Date.UTC(1899, 11, 30);
      const date = new Date(excelEpoch + numericValue * 86400000);

      return new Intl.DateTimeFormat('pl-PL', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(date);
    }

    return String(value);
  };

  const initializeChallengeMap = async () => {
    const frame = document.querySelector('[data-challenge-map-frame]');
    const container = frame?.querySelector('[data-challenge-map]');

    if (!(frame instanceof HTMLElement) || !(container instanceof HTMLElement) || container.dataset.mapReady === 'true') {
      return;
    }

    const challengeKey = frame.dataset.challengeKey;
    const progressElement = frame.querySelector('[data-challenge-progress]');

    if (!challengeKey) return;

    try {
      const L = await loadLeaflet();

      const map = L.map(container, {
        center: [48.8, 21.5],
        zoom: 7,
        zoomControl: false,
        scrollWheelZoom: true,
        doubleClickZoom: true,
        dragging: true,
        touchZoom: true,
        keyboard: true,
        preferCanvas: true,
      });

      map.attributionControl.setPrefix(false);

      const osmLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        minZoom: 0,
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
      });

      const lightLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        minZoom: 0,
        maxZoom: 20,
        subdomains: 'abcd',
        attribution: '&copy; OpenStreetMap contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      });

      osmLayer.addTo(map);

      L.control
        .layers(
          {
            OpenStreetMap: osmLayer,
            'Light map': lightLayer,
          },
          {},
          {
            position: 'topright',
            collapsed: true,
          }
        )
        .addTo(map);

      L.control
        .scale({
          position: 'bottomleft',
          imperial: false,
        })
        .addTo(map);

      const response = await fetch(`/challenges/data/challenges-${challengeKey}.json`);

      if (!response.ok) {
        throw new Error(`Challenge data could not be loaded: ${response.status}`);
      }

      const peaks = await response.json();
      const markersLayer = L.layerGroup().addTo(map);
      const bounds = [];

      const completed = peaks.filter((peak) => peak.status === 'done' || (!peak.status && Boolean(peak.date))).length;

      if (progressElement) {
        progressElement.textContent = `${completed} / ${peaks.length} completed`;
      }

      peaks.forEach((peak, index) => {
        const latitude = Number.parseFloat(peak.lat);
        const longitude = Number.parseFloat(peak.lon);

        if (Number.isNaN(latitude) || Number.isNaN(longitude)) {
          return;
        }

        const number = peak.number ?? index + 1;
        const status = peak.status === 'done' || (!peak.status && peak.date) ? 'done' : 'todo';

        const markerIcon = L.divIcon({
          className: 'challenge-number-icon',
          html: `
            <span class="challenge-number ${status}">
              ${escapeHtml(number)}
            </span>
          `,
          iconSize: [24, 24],
          iconAnchor: [12, 12],
          popupAnchor: [0, -14],
        });

        const marker = L.marker([latitude, longitude], {
          icon: markerIcon,
          title: String(peak.peak ?? ''),
        });

        marker.bindTooltip(escapeHtml(peak.peak), {
          direction: 'top',
          offset: [0, -12],
          opacity: 0.95,
        });

        marker.bindPopup(
          `
    <article class="challenge-popup">
      <h2>${escapeHtml(number)}. ${escapeHtml(peak.peak)}</h2>

      <dl>
        <div>
          <dt>Height</dt>
          <dd>${escapeHtml(peak.height)} m</dd>
        </div>

        <div>
          <dt>Region</dt>
          <dd>${escapeHtml(peak.region)}</dd>
        </div>

        <div>
          <dt>Subregion</dt>
          <dd>${escapeHtml(peak.subregion)}</dd>
        </div>

        <div>
          <dt>Status</dt>
          <dd>${status === 'done' ? 'Completed' : 'To do'}</dd>
        </div>

        <div>
          <dt>Expedition</dt>
          <dd>${escapeHtml(peak.expedition || '—')}</dd>
        </div>

        <div>
          <dt>Date</dt>
          <dd>${escapeHtml(formatChallengeDate(peak.date))}</dd>
        </div>
      </dl>
    </article>
  `,
          {
            minWidth: 300,
            maxWidth: 360,
            autoPanPadding: [24, 24],
          }
        );

        marker.on('popupopen', () => {
          marker.closeTooltip();
        });

        marker.addTo(markersLayer);
        bounds.push([latitude, longitude]);
      });

      if (bounds.length > 0) {
        map.fitBounds(bounds, {
          padding: [30, 30],
        });
      }

      container.dataset.mapReady = 'true';

      requestAnimationFrame(() => {
        map.invalidateSize();
      });
    } catch (error) {
      console.error('Challenge map initialization failed:', error);

      if (progressElement) {
        progressElement.textContent = 'Map unavailable';
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeChallengeMap, { once: true });
  } else {
    initializeChallengeMap();
  }
</script>

<style>
  .challenge-map-frame,
  .challenge-map {
    position: absolute;
    inset: 0;
  }

  .challenge-map-frame {
    overflow: hidden;
  }

  .challenge-map {
    z-index: 0;
    width: 100%;
    height: 100%;
    background: #dfe7e3;
    pointer-events: auto;
  }

  .challenge-topbar {
    position: absolute;
    z-index: 500;
    top: 10px;
    left: 10px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgb(0 0 0 / 10%);
    border-radius: 0.6rem;
    background: rgb(255 255 255 / 92%);
    box-shadow: 0 3px 10px rgb(0 0 0 / 14%);
    backdrop-filter: blur(6px);
    pointer-events: auto;
  }

  .challenge-topbar strong {
    font-family: var(--font-family-heading);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1;
  }

  .challenge-topbar > span {
    color: var(--color-text-muted);
    font-family: var(--font-family-heading);
    font-size: 0.72rem;
  }

  .challenge-legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .challenge-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .challenge-legend i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .challenge-legend .done {
    background: #287f50;
  }

  .challenge-legend .todo {
    background: #880808;
  }

  .challenge-map :global(.leaflet-container),
  .challenge-map :global(.leaflet-control),
  .challenge-map :global(.leaflet-tooltip),
  .challenge-map :global(.leaflet-popup-content) {
    font-family: var(--font-family-heading);
  }

  .challenge-map :global(.challenge-number-icon) {
    border: 0;
    background: transparent;
  }

  .challenge-map :global(.challenge-number) {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid white;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgb(0 0 0 / 30%);
    color: white;
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1;
  }

  .challenge-map :global(.challenge-number.done) {
    background: #287f50;
  }

  .challenge-map :global(.challenge-number.todo) {
    background: #880808;
  }

  .challenge-map :global(.leaflet-tooltip) {
    padding: 0.35rem 0.55rem;
    border: 1px solid rgb(0 0 0 / 12%);
    border-radius: 0.4rem;
    background: rgb(255 255 255 / 96%);
    box-shadow: 0 3px 10px rgb(0 0 0 / 14%);
    color: var(--color-text);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  .challenge-map :global(.leaflet-popup-content-wrapper) {
    border-radius: 0.85rem;
    box-shadow: 0 8px 28px rgb(0 0 0 / 22%);
  }

  .challenge-map :global(.leaflet-popup-content) {
    width: 310px;
    min-width: 300px;
    margin: 1rem 1.1rem;
  }

  .challenge-map :global(.challenge-popup) {
    min-width: 0;
  }

  .challenge-map :global(.challenge-popup h2) {
    margin: 0 0 0.9rem;
    font-family: var(--font-family-heading);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .challenge-map :global(.challenge-popup dl) {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .challenge-map :global(.challenge-popup dl div) {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }

  .challenge-map :global(.challenge-popup dt) {
    color: var(--color-text-muted);
    font-weight: 400;
    white-space: nowrap;
  }

  .challenge-map :global(.challenge-popup dd) {
    min-width: 0;
    margin: 0;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  @media (max-width: 48rem) {
    .challenge-topbar {
      right: 10px;
      flex-wrap: wrap;
    }

    .challenge-map :global(.leaflet-popup-content) {
      width: 260px;
      min-width: 250px;
      margin: 0.9rem;
    }

    .challenge-map :global(.challenge-popup dl div) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.6rem;
    }
  }
</style>
