---
import MobileHeader from "./MobileHeader.astro";

const mobileSections = [
  {
    title: "Expeditions",
    href: "/expeditions",
    className: "expeditions",
    icon: "mountain",
  },
  {
    title: "Challenges",
    href: "/challenges",
    className: "challenges",
    icon: "flag",
  },
  {
    title: "Statistics",
    href: "/statistics",
    className: "statistics",
    icon: "chart",
  },
];
---

<div class="mobile-home">
  <MobileHeader />

  <main class="mobile-navigation" aria-label="AKT Mamut mobile navigation">
    {
      mobileSections.map((section) => (
        <a
          class={`mobile-panel ${section.className}`}
          href={section.href}
        >
          <span class="panel-icon" aria-hidden="true">
            {
              section.icon === "mountain" && (
                <svg viewBox="0 0 64 64" role="img">
                  <path d="M4 52 23 20l10 16 7-10 20 26H4Z" />
                  <path d="m18 29 5-9 6 10-5-2-6 1Z" class="icon-cutout" />
                </svg>
              )
            }

            {
              section.icon === "flag" && (
                <svg viewBox="0 0 64 64" role="img">
                  <path d="M14 7h6v50h-6z" />
                  <path d="M20 10c11-7 21 7 34 0v25c-13 7-23-7-34 0V10Z" />
                </svg>
              )
            }

            {
              section.icon === "chart" && (
                <svg viewBox="0 0 64 64" role="img">
                  <rect x="8" y="34" width="10" height="22" rx="1" />
                  <rect x="27" y="23" width="10" height="33" rx="1" />
                  <rect x="46" y="10" width="10" height="46" rx="1" />
                </svg>
              )
            }
          </span>

          <span class="panel-title">{section.title}</span>

          <span class="panel-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="m9 4 8 8-8 8" />
            </svg>
          </span>
        </a>
      ))
    }
  </main>
</div>

<style>
  .mobile-home {
    display: none;
  }

  @media (max-width: 48rem) {
    .mobile-home {
      display: flex;
      min-height: 100dvh;
      flex-direction: column;
      background: var(--color-surface);
      font-family: var(--font-family-heading);
    }

    .mobile-navigation {
      display: grid;
      min-height: calc(100dvh - 4.125rem);
      flex: 1;
      grid-template-rows: repeat(3, minmax(0, 1fr));
    }

    .mobile-panel {
      position: relative;
      display: grid;
      min-height: 0;
      grid-template-columns: 4.5rem minmax(0, 1fr) 2rem;
      align-items: center;
      gap: 1.25rem;
      overflow: hidden;
      padding: 2rem 1.5rem;
      color: white;
      isolation: isolate;
      text-decoration: none;
      transition:
        filter 160ms ease,
        transform 160ms ease;
    }

    .mobile-panel::before,
    .mobile-panel::after {
      position: absolute;
      inset: 0;
      content: "";
      pointer-events: none;
    }

    .mobile-panel::before {
      z-index: -2;
      background:
        linear-gradient(
          135deg,
          rgb(255 255 255 / 10%),
          transparent 52%
        );
    }

    .mobile-panel::after {
      z-index: -1;
      opacity: 0.42;
    }

    .expeditions {
      background:
        radial-gradient(
          circle at 80% 24%,
          rgb(255 255 255 / 11%),
          transparent 34%
        ),
        linear-gradient(135deg, #6540a2 0%, #35166e 100%);
    }

    .expeditions::after {
      background:
        linear-gradient(
          155deg,
          transparent 0 48%,
          rgb(16 7 47 / 25%) 48% 100%
        ),
        linear-gradient(
          25deg,
          transparent 0 60%,
          rgb(255 255 255 / 6%) 60% 61%,
          transparent 61% 100%
        );
      clip-path: polygon(
        45% 100%,
        58% 66%,
        67% 79%,
        79% 45%,
        88% 64%,
        100% 42%,
        100% 100%
      );
    }

    .challenges {
      background:
        linear-gradient(
          135deg,
          rgb(255 255 255 / 5%),
          transparent 55%
        ),
        linear-gradient(135deg, #378d35 0%, #146923 100%);
    }

    .challenges::after {
      background:
        repeating-radial-gradient(
          ellipse at 75% 42%,
          transparent 0 1.8rem,
          rgb(255 255 255 / 12%) 1.85rem 1.9rem,
          transparent 1.95rem 3.8rem
        );
    }

    .statistics {
      background:
        radial-gradient(
          circle at 18% 14%,
          rgb(255 255 255 / 10%),
          transparent 36%
        ),
        linear-gradient(135deg, #2876aa 0%, #0d4d81 100%);
    }

    .statistics::after {
      background:
        linear-gradient(
          160deg,
          transparent 0 70%,
          rgb(255 255 255 / 8%) 70% 71%,
          transparent 71% 100%
        ),
        linear-gradient(
          to top,
          rgb(255 255 255 / 7%) 0 22%,
          transparent 22% 100%
        );
      clip-path: polygon(
        0 100%,
        0 88%,
        14% 88%,
        14% 73%,
        29% 73%,
        29% 80%,
        44% 80%,
        44% 58%,
        59% 58%,
        59% 68%,
        74% 68%,
        74% 43%,
        88% 43%,
        88% 51%,
        100% 51%,
        100% 100%
      );
    }

    .panel-icon,
    .panel-title,
    .panel-arrow {
      position: relative;
      z-index: 1;
    }

    .panel-icon {
      display: grid;
      width: 4rem;
      height: 4rem;
      place-items: center;
    }

    .panel-icon svg {
      width: 100%;
      height: 100%;
      fill: currentColor;
    }

    .panel-icon .icon-cutout {
      fill: rgb(255 255 255 / 80%);
    }

    .panel-title {
      min-width: 0;
      font-family: inherit;
      font-size: clamp(2rem, 10vw, 3.25rem);
      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1;
      text-transform: uppercase;
    }

    .panel-arrow {
      display: grid;
      width: 2rem;
      height: 3rem;
      place-items: center;
    }

    .panel-arrow svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 3;
    }

    .mobile-panel:hover,
    .mobile-panel:focus-visible {
      filter: brightness(1.09);
    }

    .mobile-panel:active {
      transform: scale(0.992);
      filter: brightness(0.96);
    }

    .mobile-panel:focus-visible {
      outline: 3px solid white;
      outline-offset: -3px;
    }
  }

  @media (max-width: 26rem) {
    .mobile-panel {
      grid-template-columns: 3.25rem minmax(0, 1fr) 1.75rem;
      gap: 0.9rem;
      padding: 1.5rem 1rem;
    }

    .panel-icon {
      width: 3rem;
      height: 3rem;
    }

    .panel-title {
      font-size: clamp(1.75rem, 9vw, 2.5rem);
    }

    .panel-arrow {
      width: 1.5rem;
      height: 2.5rem;
    }
  }
</style>